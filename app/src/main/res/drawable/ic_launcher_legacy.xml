        android:pathData="M10,0 L38,0 A10,10 0 0 1 48,10 L48,38 A10,10 0 0 1 38,48 L10,48 A10,10 0 0 1 0,38 L0,10 A10,10 0 0 1 10,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="24" android:startY="0"
                android:endX="24" android:endY="48">
                <item android:color="#5FD3FF" android:offset="0.0" />
                <item android:color="#3AA9F5" android:offset="0.5" />
                <item android:color="#1565C0" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft shadow -->
    <path
        android:fillColor="#33000000"
        android:pathData="M24,36.44 m-12.44,0 a12.44,2.67 0 1 1 24.88,0 a12.44,2.67 0 1 1 -24.88,0" />

