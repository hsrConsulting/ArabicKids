        android:fillColor="#1A1A1A"
        android:pathData="M18.67,22.22 m-2.22,0 a2.22,2.22 0 1 1 4.44,0 a2.22,2.22 0 1 1 -4.44,0" />
    <path
        android:fillColor="#1A1A1A"
        android:pathData="M29.33,22.22 m-2.22,0 a2.22,2.22 0 1 1 4.44,0 a2.22,2.22 0 1 1 -4.44,0" />

