<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-API 26 launcher fallback (48dp, full-bleed).
  Includes the blue gradient background + scaled-down smiley ب so devices
  on Android 7 (minSdk 24) still get a branded icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Rounded-square background (3-stop blue gradient, top → bottom) -->
