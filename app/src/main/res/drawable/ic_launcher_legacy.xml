        android:fillColor="#80FFFFFF"
        android:pathData="M13.33,21.33 C20,15.56 28.89,15.56 34.67,21.33 C28.89,20 20,20 13.33,21.33 Z" />

    <!-- Yellow dot -->
    <path
        android:fillColor="#FFD54F"
        android:pathData="M24,35.56 m-2.67,0 a2.67,2.67 0 1 1 5.34,0 a2.67,2.67 0 1 1 -5.34,0" />

    <!-- Eyes -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M18.67,21.33 m-4.89,0 a4.89,4.89 0 1 1 9.78,0 a4.89,4.89 0 1 1 -9.78,0" />
